generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  memberships  WorkspaceMember[]
  labels       Label[]
  transactions Transaction[]
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  members      WorkspaceMember[]
  labels       Label[]
  transactions Transaction[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  role        Role     @default(viewer)
  userId      String
  workspaceId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
}

model Label {
  id          String    @id @default(uuid())
  name        String
  kind        LabelKind
  userId      String?
  workspaceId String?
  createdAt   DateTime  @default(now())

  user      User?      @relation(fields: [userId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  sourceTransactions   Transaction[] @relation("source")
  categoryTransactions Transaction[] @relation("category")

  @@index([userId])
  @@index([workspaceId])
}

model Transaction {
  id          String   @id @default(uuid())
  amountCents Int
  date        DateTime
  note        String?
  createdAt   DateTime @default(now())

  userId      String
  workspaceId String?

  sourceLabelId   String?
  categoryLabelId String?

  user      User       @relation(fields: [userId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  source   Label? @relation("source", fields: [sourceLabelId], references: [id])
  category Label? @relation("category", fields: [categoryLabelId], references: [id])

  @@index([workspaceId, date])
  @@index([userId, date])
}

enum Role {
  viewer
  editor
  admin
}

enum LabelKind {
  source
  category
}
